generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// --- ГЕОГРАФИЯ И КЛУБЫ ---

model countries {
  id   Int    @id @default(autoincrement())
  name String @db.VarChar(255)

  cities      cities[]
  fighters    fighters[]
  marshals    marshals[]
  tournaments tournaments[]
}

model cities {
  id         Int    @id @default(autoincrement())
  country_id Int
  name       String @db.VarChar(255)

  country     countries     @relation(fields: [country_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  clubs       clubs[]
  fighters    fighters[]
  marshals    marshals[]
  tournaments tournaments[]
}

model clubs {
  id      Int    @id @default(autoincrement())
  city_id Int
  name    String @db.VarChar(255)

  city     cities     @relation(fields: [city_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  fighters fighters[]
}

// --- БОЙЦЫ И ТУРНИРЫ ---

model fighters {
  id         Int       @id @default(autoincrement())
  name       String    @db.VarChar(255)
  surname    String    @db.VarChar(255)
  patronymic String?   @db.VarChar(255)
  birthday   DateTime? @db.Date
  country_id Int
  city_id    Int
  club_id    Int?
  pic        String?
  is_male    Boolean   @default(true)

  country                   countries                           @relation(fields: [country_id], references: [id])
  city                      cities                              @relation(fields: [city_id], references: [id])
  club                      clubs?                              @relation(fields: [club_id], references: [id])
  competitors               competitors[]
  disciplinary_cards        disciplinary_cards[]
  nomination_ratings        fighter_nomination_ratings[]
  nomination_rating_history fighter_nomination_rating_history[]
  russia_hmb_rating_results russia_hmb_rating_results[]
}

model marshals {
  id          Int     @id @default(autoincrement())
  name        String  @db.VarChar(255)
  surname     String  @db.VarChar(255)
  patronymic  String? @db.VarChar(255)
  country_id  Int
  city_id     Int
  category_id Int
  pic         String?

  country            countries             @relation(fields: [country_id], references: [id])
  city               cities                @relation(fields: [city_id], references: [id])
  category           marshals_categories   @relation(fields: [category_id], references: [id])
  tournaments        tournament_marshals[]
  disciplinary_cards disciplinary_cards[]
}

model marshals_categories {
  id      Int    @id @default(autoincrement())
  name_ru String @db.VarChar(255)
  name_en String @db.VarChar(255)

  marshals marshals[]
}

model tournaments {
  id                              Int       @id @default(autoincrement())
  name                            String    @db.VarChar(255)
  event_date                      DateTime? @db.Date
  country_id                      Int
  city_id                         Int
  is_marshals_registration_closed Boolean   @default(false)

  country                countries                           @relation(fields: [country_id], references: [id])
  city                   cities                              @relation(fields: [city_id], references: [id])
  nominations            tournament_nominations[]
  competitors            competitors[]
  groups                 groups[]
  fights                 fights[]
  reports                tournament_reports[]
  disciplinary_cards     disciplinary_cards[]
  fighter_withdrawals    fighter_withdrawals[]
  fighter_rating_history fighter_nomination_rating_history[]
  russia_hmb_rating_calculations russia_hmb_rating_calculations[]
  russia_hmb_rating_results      russia_hmb_rating_results[]
  marshals               tournament_marshals[]
}

model tournament_marshals {
  id            Int      @id @default(autoincrement())
  tournament_id Int
  marshal_id    Int
  created_at    DateTime @default(now())

  tournament tournaments @relation(fields: [tournament_id], references: [id], onDelete: Cascade)
  marshal    marshals    @relation(fields: [marshal_id], references: [id], onDelete: Cascade)

  @@unique([tournament_id, marshal_id])
  @@index([marshal_id])
}

model nominations {
  id                    Int     @id @default(autoincrement())
  name_ru               String  @db.VarChar(255)
  name_en               String  @db.VarChar(255)
  is_male               Boolean @default(true)
  rounds                Int     @default(1)
  round_win             Boolean @default(false)
  main_round_time       Int     @default(0)
  additional_round_time Int     @default(0)

  tournaments            tournament_nominations[]
  competitors            competitors[]
  groups                 groups[]
  fights                 fights[]
  fighter_ratings        fighter_nomination_ratings[]
  fighter_rating_history fighter_nomination_rating_history[]
  russia_hmb_rating_calculations russia_hmb_rating_calculations[]
  russia_hmb_rating_results      russia_hmb_rating_results[]

  @@unique([name_ru, is_male])
  @@unique([name_en, is_male])
}

// --- СОРЕВНОВАТЕЛЬНАЯ ЛОГИКА ---

model tournament_nominations {
  id                   Int       @id @default(autoincrement())
  tournament_id        Int
  nomination_id        Int
  is_open              Boolean   @default(true)
  is_finished          Boolean   @default(false)
  stage                Int       @default(0)
  rating_status        String    @default("PENDING") @db.VarChar(32)
  rating_calculated_at DateTime?
  rating_error         String?   @db.Text

  tournament     tournaments                         @relation(fields: [tournament_id], references: [id], onDelete: Cascade)
  nomination     nominations                         @relation(fields: [nomination_id], references: [id], onDelete: Cascade)
  blocks         competition_blocks[]
  placements     competition_placements[]
  withdrawals    fighter_withdrawals[]
  rating_history fighter_nomination_rating_history[]
  russia_hmb_rating_calculation russia_hmb_rating_calculations?
  russia_hmb_rating_results     russia_hmb_rating_results[]

  @@index([tournament_id, nomination_id])
}

model competitors {
  id            Int @id @default(autoincrement())
  fighter_id    Int
  tournament_id Int
  nomination_id Int
  stage         Int @default(0)

  fighter       fighters                 @relation(fields: [fighter_id], references: [id], onDelete: Cascade)
  tournament    tournaments              @relation(fields: [tournament_id], references: [id], onDelete: Cascade)
  nomination    nominations              @relation(fields: [nomination_id], references: [id], onDelete: Cascade)
  groups        group_competitors[]
  bracket_slots bracket_slots[]
  placements    competition_placements[]
  withdrawals   fighter_withdrawals[]
  russia_hmb_rating_results russia_hmb_rating_results[]

  // Связи для таблицы боев (кто участвовал)
  fights_as_f1   fights[]         @relation("Fighter1")
  fights_as_f2   fights[]         @relation("Fighter2")
  fights_won     fights[]         @relation("Winner")
  fight_warnings fight_warnings[]

  @@index([tournament_id, nomination_id])
  @@index([fighter_id, tournament_id, nomination_id])
}

model groups {
  id            Int    @id @default(autoincrement())
  tournament_id Int
  nomination_id Int
  block_id      Int?
  name          String @db.VarChar(255)
  stage         Int    @default(0)

  tournament tournaments              @relation(fields: [tournament_id], references: [id], onDelete: Cascade)
  nomination nominations              @relation(fields: [nomination_id], references: [id], onDelete: Cascade)
  block      competition_blocks?      @relation(fields: [block_id], references: [id], onDelete: Cascade)
  fighters   group_competitors[]
  fights     fights[]
  placements competition_placements[]
}

model group_competitors {
  id            Int @id @default(autoincrement())
  group_id      Int
  competitor_id Int

  group      groups      @relation(fields: [group_id], references: [id], onDelete: Cascade)
  competitor competitors @relation(fields: [competitor_id], references: [id], onDelete: Cascade)
}

model fights {
  id                    Int     @id @default(autoincrement())
  tournament_id         Int
  nomination_id         Int
  block_id              Int?
  group_id              Int?
  competitor1_id        Int
  competitor2_id        Int
  competitor1_score     Int     @default(0)
  competitor2_score     Int     @default(0)
  winner_id             Int?
  stage                 Int     @default(0)
  fight_number          Int     @default(0)
  bracket_round         Int?
  bracket_position      Int?
  is_bronze             Boolean @default(false)
  is_finished           Boolean @default(false)
  forfeit_card_id       Int?
  forfeit_withdrawal_id Int?
  rounds                Int     @default(1)
  round_win             Boolean @default(false)
  main_round_time       Int     @default(0)
  additional_round_time Int     @default(0)

  tournament tournaments         @relation(fields: [tournament_id], references: [id], onDelete: Cascade)
  nomination nominations         @relation(fields: [nomination_id], references: [id], onDelete: Cascade)
  block      competition_blocks? @relation(fields: [block_id], references: [id], onDelete: Cascade)
  group      groups?             @relation(fields: [group_id], references: [id])

  // Именованные связи для различения двух бойцов
  competitor1        competitors          @relation("Fighter1", fields: [competitor1_id], references: [id])
  competitor2        competitors          @relation("Fighter2", fields: [competitor2_id], references: [id])
  winner             competitors?         @relation("Winner", fields: [winner_id], references: [id])
  disciplinary_cards disciplinary_cards[]
  warnings           fight_warnings[]
  round_scores       fight_round_scores[]
  forfeit_withdrawal fighter_withdrawals? @relation("WithdrawalForfeitFight", fields: [forfeit_withdrawal_id], references: [id], onDelete: SetNull)
  source_withdrawals fighter_withdrawals[] @relation("WithdrawalSourceFight")

  @@index([forfeit_card_id])
  @@index([forfeit_withdrawal_id])
  @@index([block_id, fight_number])
  @@index([tournament_id, nomination_id, is_finished])
}

model fighter_withdrawals {
  id                       Int       @id @default(autoincrement())
  tournament_nomination_id Int
  tournament_id            Int
  nomination_id            Int
  competitor_id            Int
  source                   String    @db.VarChar(16)
  source_fight_id          Int?
  source_block_id          Int?
  source_fight_number      Int?
  reason                   String    @db.Text
  is_excused               Boolean   @default(false)
  active                   Boolean   @default(true)
  created_at               DateTime  @default(now())
  canceled_at              DateTime?

  tournament_nomination tournament_nominations @relation(fields: [tournament_nomination_id], references: [id], onDelete: Cascade)
  tournament            tournaments            @relation(fields: [tournament_id], references: [id], onDelete: Cascade)
  competitor            competitors            @relation(fields: [competitor_id], references: [id], onDelete: Cascade)
  source_fight          fights?                @relation("WithdrawalSourceFight", fields: [source_fight_id], references: [id], onDelete: SetNull)
  forfeited_fights      fights[]               @relation("WithdrawalForfeitFight")

  @@index([tournament_nomination_id, active])
  @@index([tournament_id, nomination_id, active])
  @@index([competitor_id, active])
  @@index([source_fight_id])
}

model fight_round_scores {
  id                Int @id @default(autoincrement())
  fight_id          Int
  round             Int
  competitor1_score Int @default(0)
  competitor2_score Int @default(0)
  duration_seconds  Int @default(0)

  fight fights @relation(fields: [fight_id], references: [id], onDelete: Cascade)

  @@unique([fight_id, round])
  @@index([fight_id])
}

model fight_warnings {
  id            Int      @id @default(autoincrement())
  fight_id      Int
  competitor_id Int
  round         Int
  reason        String   @db.Text
  created_at    DateTime @default(now())

  fight      fights      @relation(fields: [fight_id], references: [id], onDelete: Cascade)
  competitor competitors @relation(fields: [competitor_id], references: [id], onDelete: Cascade)

  @@index([fight_id])
  @@index([competitor_id])
}

model disciplinary_cards {
  id            Int      @id @default(autoincrement())
  fighter_id    Int
  tournament_id Int
  fight_id      Int
  marshal_id    Int
  type          String   @db.VarChar(16)
  source        String   @default("MANUAL") @db.VarChar(16)
  received_at   DateTime @db.Date
  reason        String   @db.Text
  expires_at    DateTime @db.Date
  active        Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  fighter                           fighters                  @relation(fields: [fighter_id], references: [id], onDelete: Cascade)
  tournament                        tournaments               @relation(fields: [tournament_id], references: [id], onDelete: Cascade)
  fight                             fights                    @relation(fields: [fight_id], references: [id], onDelete: Cascade)
  marshal                           marshals                  @relation(fields: [marshal_id], references: [id])
  red_card_yellow_sources_as_red    red_card_yellow_sources[] @relation("RedCardSources")
  red_card_yellow_sources_as_yellow red_card_yellow_sources[] @relation("YellowCardSources")

  @@index([fighter_id, type, received_at, expires_at])
  @@index([tournament_id])
  @@index([fight_id])
  @@index([marshal_id])
}

model red_card_yellow_sources {
  id                             Int       @id @default(autoincrement())
  red_card_id                    Int
  yellow_card_id                 Int
  yellow_expires_at_before_close DateTime? @db.Date
  yellow_active_before_close     Boolean?
  closed_at                      DateTime? @db.Date
  created_at                     DateTime  @default(now())

  red_card    disciplinary_cards @relation("RedCardSources", fields: [red_card_id], references: [id], onDelete: Cascade)
  yellow_card disciplinary_cards @relation("YellowCardSources", fields: [yellow_card_id], references: [id], onDelete: Cascade)

  @@unique([red_card_id, yellow_card_id])
  @@index([yellow_card_id])
}

model disciplinary_card_settings {
  id                                       Int      @id @default(1)
  yellow_expiration_mode                   String   @default("END_OF_YEAR_MONTH") @db.VarChar(32)
  yellow_expiration_month                  Int      @default(12)
  yellow_expiration_days                   Int      @default(365)
  red_auto_yellow_days                     Int      @default(45)
  red_manual_days                          Int      @default(90)
  red_manual_with_one_yellow_days          Int      @default(120)
  red_manual_with_two_or_more_yellows_days Int      @default(180)
  updated_at                               DateTime @updatedAt
}

model fighter_nomination_ratings {
  id            Int      @id @default(autoincrement())
  nomination_id Int
  fighter_id    Int
  rating        Int      @default(1000)
  fights_count  Int      @default(0)
  updated_at    DateTime @updatedAt

  nomination nominations @relation(fields: [nomination_id], references: [id], onDelete: Cascade)
  fighter    fighters    @relation(fields: [fighter_id], references: [id], onDelete: Cascade)

  @@unique([nomination_id, fighter_id])
  @@index([nomination_id, rating])
}

model fighter_nomination_rating_history {
  id                       Int      @id @default(autoincrement())
  nomination_id            Int
  fighter_id               Int
  tournament_id            Int
  tournament_nomination_id Int
  rating_before            Int
  rating_after             Int
  fights_count_delta       Int
  created_at               DateTime @default(now())

  nomination            nominations            @relation(fields: [nomination_id], references: [id], onDelete: Cascade)
  fighter               fighters               @relation(fields: [fighter_id], references: [id], onDelete: Cascade)
  tournament            tournaments            @relation(fields: [tournament_id], references: [id], onDelete: Cascade)
  tournament_nomination tournament_nominations @relation(fields: [tournament_nomination_id], references: [id], onDelete: Cascade)

  @@unique([tournament_nomination_id, fighter_id])
  @@index([nomination_id, fighter_id, tournament_id])
  @@index([fighter_id, created_at])
}

model russia_hmb_rating_calculations {
  id                       Int      @id @default(autoincrement())
  tournament_nomination_id Int      @unique
  tournament_id            Int
  nomination_id            Int
  event_year               Int
  coefficient              Int
  calculated_by_user_id    Int?
  calculated_at            DateTime @default(now())

  tournament_nomination tournament_nominations    @relation(fields: [tournament_nomination_id], references: [id], onDelete: Cascade)
  tournament            tournaments               @relation(fields: [tournament_id], references: [id], onDelete: Cascade)
  nomination            nominations               @relation(fields: [nomination_id], references: [id], onDelete: Cascade)
  calculated_by         users?                    @relation(fields: [calculated_by_user_id], references: [id], onDelete: SetNull)
  results               russia_hmb_rating_results[]

  @@index([event_year, nomination_id])
  @@index([tournament_id, nomination_id])
  @@index([calculated_by_user_id])
}

model russia_hmb_rating_results {
  id                       Int @id @default(autoincrement())
  calculation_id           Int
  tournament_nomination_id Int
  tournament_id            Int
  nomination_id            Int
  fighter_id               Int
  competitor_id            Int
  points                   Int
  qc_points                Int @default(0)
  qn_points                Int @default(0)
  qm_points                Int @default(0)
  yellow_cards_count       Int @default(0)
  active_red_cards_count   Int @default(0)
  no_show_penalty_count    Int @default(0)

  calculation           russia_hmb_rating_calculations @relation(fields: [calculation_id], references: [id], onDelete: Cascade)
  tournament_nomination tournament_nominations         @relation(fields: [tournament_nomination_id], references: [id], onDelete: Cascade)
  tournament            tournaments                    @relation(fields: [tournament_id], references: [id], onDelete: Cascade)
  nomination            nominations                    @relation(fields: [nomination_id], references: [id], onDelete: Cascade)
  fighter               fighters                       @relation(fields: [fighter_id], references: [id], onDelete: Cascade)
  competitor            competitors                    @relation(fields: [competitor_id], references: [id], onDelete: Cascade)

  @@unique([calculation_id, fighter_id])
  @@unique([tournament_nomination_id, fighter_id])
  @@index([nomination_id, fighter_id])
  @@index([fighter_id])
  @@index([tournament_id, nomination_id])
  @@index([points])
}

model competition_blocks {
  id                       Int      @id @default(autoincrement())
  tournament_nomination_id Int
  tournament_id            Int
  nomination_id            Int
  type                     String   @db.VarChar(32)
  stage                    Int
  status                   String   @default("ACTIVE") @db.VarChar(32)
  lifecycle_state          String   @default("FORMATION_EDITABLE") @db.VarChar(32)
  created_at               DateTime @default(now())

  tournament_nomination tournament_nominations     @relation(fields: [tournament_nomination_id], references: [id], onDelete: Cascade)
  groups                groups[]
  fights                fights[]
  bracket_slots         bracket_slots[]
  placements            competition_placements[]
  round_states          competition_round_states[]

  @@index([tournament_nomination_id, stage])
}

model competition_round_states {
  id            Int     @id @default(autoincrement())
  block_id      Int
  round         Int
  pairs_fixed   Boolean @default(false)
  results_fixed Boolean @default(false)

  block competition_blocks @relation(fields: [block_id], references: [id], onDelete: Cascade)

  @@unique([block_id, round])
}

model bracket_slots {
  id            Int @id @default(autoincrement())
  block_id      Int
  competitor_id Int
  seed_position Int
  slot_position Int

  block      competition_blocks @relation(fields: [block_id], references: [id], onDelete: Cascade)
  competitor competitors        @relation(fields: [competitor_id], references: [id], onDelete: Cascade)

  @@unique([block_id, slot_position])
  @@unique([block_id, competitor_id])
}

model competition_placements {
  id                       Int    @id @default(autoincrement())
  tournament_nomination_id Int
  block_id                 Int?
  group_id                 Int?
  competitor_id            Int
  scope                    String @db.VarChar(32)
  place                    Int

  tournament_nomination tournament_nominations @relation(fields: [tournament_nomination_id], references: [id], onDelete: Cascade)
  block                 competition_blocks?    @relation(fields: [block_id], references: [id], onDelete: Cascade)
  group                 groups?                @relation(fields: [group_id], references: [id], onDelete: Cascade)
  competitor            competitors            @relation(fields: [competitor_id], references: [id], onDelete: Cascade)

  @@unique([tournament_nomination_id, scope, group_id, place], map: "competition_placements_group_place_key")
  @@unique([tournament_nomination_id, scope, group_id, competitor_id], map: "competition_placements_group_competitor_key")
}

// --- ПОЛЬЗОВАТЕЛИ ---

model tournament_reports {
  id            Int      @id @default(autoincrement())
  tournament_id Int
  language      String   @db.VarChar(8)
  file_name     String   @db.VarChar(255)
  pdf_data      Bytes
  generated_at  DateTime @default(now())

  tournament tournaments @relation(fields: [tournament_id], references: [id], onDelete: Cascade)

  @@unique([tournament_id, language])
}

model users {
  id           Int      @id @default(autoincrement())
  username     String   @unique @db.VarChar(255)
  password     String   @db.VarChar(255)
  surname      String   @db.VarChar(255)
  name         String   @db.VarChar(255)
  patronymic   String?  @db.VarChar(255)
  email        String?  @unique @db.VarChar(255)
  is_admin     Boolean  @default(false)
  is_organizer Boolean  @default(false)
  is_secretary Boolean  @default(false)
  refreshToken String?  @db.Text
  createdAt    DateTime @default(now())
  russia_hmb_rating_calculations russia_hmb_rating_calculations[]
}
